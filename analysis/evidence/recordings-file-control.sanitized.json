      "source": {
        "status": "complete",
        "text": "    public static JSONObject createCommonFileListCtrlJsonHeader(long j, FileListCtrl fileListCtrl, JSONArray jSONArray) {\n        JSONObject jSONObject = new JSONObject();\n        try {\n            jSONObject.put(\"dfid\", j);\n            jSONObject.put(\"ctrl\", fileListCtrl.getValue());\n            jSONObject.put(\"cnt\", jSONArray.length());\n            jSONObject.put(\"list\", jSONArray);\n        } catch (JSONException e) {\n            LogUtils.e(TAG, H.a(e, I.a(e, \"createCommonFileListCtrlJsonHeader: jsonData put fail, exception=\")));\n        }\n        return jSONObject;\n    }",
        "reported_total_bytes": null
      }
